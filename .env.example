GITHUB_OWNER=droderuan
GITHUB_REPO=rifa_carrozza
GITHUB_BRANCH=dados-teste
GITHUB_DB_PATH=rifa.json
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
