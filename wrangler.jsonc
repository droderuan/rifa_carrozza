{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "rifa-carrozza",
	// Conta "rifa_carrozza" — fixa o destino do deploy, independente da conta do login
	"account_id": "8633b5a14d174b3a1ef9f5bcff4048a0",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "rifa-carrozza"
		}
	],
	// Segredos (GITHUB_TOKEN, ADMIN_PASSWORD, ADMIN_SESSION_SECRET) via `wrangler secret put`
	"vars": {
		"GITHUB_OWNER": "droderuan",
		"GITHUB_REPO": "rifa_carrozza",
		"GITHUB_BRANCH": "dados-producao",
		"GITHUB_DB_PATH": "rifa.json"
	}
}
